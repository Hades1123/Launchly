PORT=4000
NODE_ENV=development
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://launchly:launchly@localhost:5433/launchly
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters
STORAGE_DRIVER=local
MAIL_DRIVER=smtp
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@launchly.local
SES_FROM=
# AI: `mock` (default, no key, deterministic) or `gemini` (needs GEMINI_API_KEY).
AI_DRIVER=mock
# AI_MODEL=gemini-3.5-flash-lite   # check with `pnpm --filter @launchly/api ai:smoke`
# GEMINI_API_KEY=
# Sign-ins per IP per 2 minutes (default 10); only the Playwright run raises it.
# LOGIN_RATE_LIMIT=10
