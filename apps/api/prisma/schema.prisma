generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  GOOGLE_ACCOUNT_LINK
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String?
  googleId           String?             @unique
  fullName           String?
  role               UserRole            @default(CANDIDATE)
  emailVerifiedAt    DateTime?
  lockedAt           DateTime?
  candidateProfile   CandidateProfile?
  ownedCompanies     Company[]           @relation("CompanyOwner")
  createdJobs        Job[]               @relation("JobCreator")
  reviewedCompanies  Company[]           @relation("CompanyReviewer")
  reviewedJobs       Job[]               @relation("JobReviewer")
  interviewQuestions InterviewQuestion[] @relation("QuestionAuthor")
  notifications      Notification[]
  authTokens         AuthToken[]
  authSessions       AuthSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model AuthToken {
  id              String           @id @default(uuid())
  userId          String
  tokenHash       String           @unique
  purpose         AuthTokenPurpose
  providerSubject String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum CompanyModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobLevel {
  INTERN
  FRESHER
  JUNIOR
}

enum JobPublicationStatus {
  DRAFT
  PENDING
  PUBLISHED
  CLOSED
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AssessmentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum InterviewSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PracticeScope {
  FULL
  ROUND
}

enum NotificationType {
  APPLICATION_STATUS
  MODERATION
}

model CandidateProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  headline            String?
  bio                 String?
  location            String?
  schoolMajor         String?
  skills              String[]
  projectsActivities  String?
  aiConsentAcceptedAt DateTime?
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  resumes             Resume[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  applications        Application[]
  interviewSessions   InterviewSession[]
}

model Resume {
  id           String           @id @default(uuid())
  candidateId  String
  fileName     String
  storageKey   String           @unique
  contentType  String
  sizeBytes    Int
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  applications Application[]
  assessments  AiAssessment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([candidateId])
}

model Company {
  id               String                  @id @default(uuid())
  ownerId          String
  name             String
  nameNormalized   String?
  address          String?
  industry         String?
  companySize      String?
  description      String?
  website          String?
  logoUrl          String?
  moderationStatus CompanyModerationStatus @default(PENDING)
  moderationReason String?
  reviewedById     String?
  reviewedAt       DateTime?
  owner            User                    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviewedBy       User?                   @relation("CompanyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  jobs             Job[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([ownerId])
  @@index([reviewedById])
  @@index([moderationStatus])
  @@index([nameNormalized])
}

model Job {
  id                 String               @id @default(uuid())
  companyId          String
  createdById        String
  title              String
  titleNormalized    String?
  description        String
  level              JobLevel?
  location           String
  industry           String?
  requirements       String[]
  benefits           String[]
  salaryMin          Decimal?
  salaryMax          Decimal?
  salaryHidden       Boolean              @default(false)
  publicationStatus  JobPublicationStatus @default(DRAFT)
  moderationReason   String?
  reviewedById       String?
  reviewedAt         DateTime?
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User                 @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy         User?                @relation("JobReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  stages             JobStage[]
  notes              JobNote[]
  applications       Application[]
  assessments        AiAssessment[]
  interviewQuestions InterviewQuestion[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  interviewSessions  InterviewSession[]

  @@index([companyId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([publicationStatus])
  @@index([industry])
  @@index([level])
  @@index([location])
  @@index([titleNormalized])
}

model JobStage {
  id                       String                   @id @default(uuid())
  jobId                    String
  name                     String
  description              String?
  position                 Int
  format                   String?
  estimatedDurationMinutes Int?
  job                      Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications             Application[]
  practiceRounds           InterviewPracticeRound[]

  @@unique([jobId, position])
  @@index([jobId])
}

model JobNote {
  id       String @id @default(uuid())
  jobId    String
  content  String
  position Int
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@index([jobId])
}

model Application {
  id                String                     @id @default(uuid())
  candidateId       String
  jobId             String
  resumeId          String
  currentStageId    String?
  status            ApplicationStatus          @default(SUBMITTED)
  coverLetter       String?
  candidate         CandidateProfile           @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job               Job                        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resume            Resume                     @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  currentStage      JobStage?                  @relation(fields: [currentStageId], references: [id], onDelete: SetNull)
  statusHistory     ApplicationStatusHistory[]
  interviewSessions InterviewSession[]
  notifications     Notification[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  changedAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
}

model AiAssessment {
  id                     String           @id @default(uuid())
  resumeId               String
  jobId                  String?
  suppliedJobDescription String?
  status                 AssessmentStatus @default(PENDING)
  score                  Decimal?
  matchedSkills          String[]
  missingSkills          String[]
  suggestions            String[]
  evidence               String?
  result                 Json?
  advisoryLabel          String?
  failureReason          String?
  resume                 Resume           @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  job                    Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([resumeId])
  @@index([jobId])
  @@index([status])
}

model InterviewQuestion {
  id        String            @id @default(uuid())
  jobId     String?
  authorId  String
  prompt    String
  job       Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  author    User              @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  answers   InterviewAnswer[]
  createdAt DateTime          @default(now())

  @@index([jobId])
  @@index([authorId])
}

model InterviewSession {
  id                 String                   @id @default(uuid())
  applicationId      String?
  candidateId        String
  jobId              String
  scope              PracticeScope            @default(FULL)
  status             InterviewSessionStatus   @default(NOT_STARTED)
  interviewConsentAt DateTime?
  lastActivityAt     DateTime                 @default(now())
  expiresAt          DateTime?
  summary            String?
  startedAt          DateTime?
  completedAt        DateTime?
  application        Application?             @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  candidate          CandidateProfile         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job                Job                      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  answers            InterviewAnswer[]
  rounds             InterviewPracticeRound[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([applicationId])
  @@index([candidateId, createdAt])
  @@index([jobId])
  @@index([expiresAt])
}

/// A round of a practice session, copied from the job's stage so history survives recruiter edits.
model InterviewPracticeRound {
  id        String                      @id @default(uuid())
  sessionId String
  stageId   String?
  name      String
  position  Int
  status    InterviewSessionStatus      @default(NOT_STARTED)
  feedback  String?
  session   InterviewSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stage     JobStage?                   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  questions InterviewPracticeQuestion[]

  @@unique([sessionId, position])
  @@index([stageId])
}

/// A generated question owned by one practice session; never part of the recruiter question bank.
model InterviewPracticeQuestion {
  id       String                   @id @default(uuid())
  roundId  String
  position Int
  prompt   String
  source   String
  round    InterviewPracticeRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  answer   InterviewPracticeAnswer?

  @@unique([roundId, position])
}

model InterviewPracticeAnswer {
  id         String                    @id @default(uuid())
  questionId String                    @unique
  answer     String
  feedback   String?
  score      Decimal?
  question   InterviewPracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime                  @default(now())
}

model InterviewAnswer {
  id         String            @id @default(uuid())
  sessionId  String
  questionId String
  answer     String
  feedback   String?
  score      Decimal?
  session    InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now())

  @@unique([sessionId, questionId])
  @@index([questionId])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  applicationId String?
  type          NotificationType
  title         String
  message       String
  readAt        DateTime?
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([userId, readAt])
  @@index([applicationId])
}
